<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Reportes">

    <TextView
        android:id="@+id/tvTituloReportes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Historial de Ventas"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvIngresosTotales"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresos Totales: $0.00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#15803D"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloReportes"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVentas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvIngresosTotales"
        app:layout_constraintBottom_toTopOf="@id/btnCorteCaja"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnCorteCaja"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="Realizar Corte de Caja"
        android:backgroundTint="#DC2626"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>