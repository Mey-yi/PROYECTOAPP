<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".Ventas">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Venta de Mostrador"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona un artículo:"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spProductosVenta"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etCantidadVenta"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Cantidad a vender"
        android:inputType="number"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvTotalVenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total a pagar: $0.00"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#059669"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnConfirmarVenta"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Confirmar Venta"
        android:backgroundTint="#2563EB" />

</LinearLayout>